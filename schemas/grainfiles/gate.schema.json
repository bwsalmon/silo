{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/gate.schema.json",
  "title": "A merge gate (docs/grainfiles-spec.md §7.6)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "match": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths_ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "paths"
      ]
    },
    "requires": {
      "type": "object",
      "properties": {
        "human": {
          "type": "object",
          "properties": {
            "when": {
              "enum": [
                "always",
                "on-findings",
                "never"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "when"
          ]
        },
        "security_review": {
          "type": "object",
          "properties": {
            "template": {
              "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
            }
          },
          "additionalProperties": false,
          "required": [
            "template"
          ]
        },
        "second_review": {
          "type": "object",
          "properties": {
            "template": {
              "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
            }
          },
          "additionalProperties": false,
          "required": [
            "template"
          ]
        }
      },
      "additionalProperties": false
    },
    "sensitive": {
      "type": "boolean"
    }
  },
  "required": [
    "match",
    "requires"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
