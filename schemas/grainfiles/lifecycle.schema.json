{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/lifecycle.schema.json",
  "title": "A lifecycle (docs/grainfiles-spec.md §7.9)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "category": {
            "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/category"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "category"
        ]
      }
    },
    "initial": {
      "type": "string"
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ]
      }
    }
  },
  "required": [
    "title",
    "states",
    "initial",
    "transitions"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
