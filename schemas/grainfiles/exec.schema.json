{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/exec.schema.json",
  "title": "grain/exec@v1: a task execution's exec.md, in <name>.exec/ in a deployment's lane (\u00a77.2)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "exec"
    },
    "schema": {
      "const": "grain/exec@v1"
    },
    "aka": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moved_from": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/refString"
      }
    },
    "instantiated_from": {
      "type": "string",
      "pattern": "@[0-9a-f]{40}$"
    },
    "definition": {
      "type": "string",
      "pattern": "^[^\\s\\\\]+@[0-9a-f]{40}$"
    },
    "definition_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "object"
    },
    "state": {
      "$ref": "common.schema.json#/$defs/stateName"
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/refString"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/principal"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "created_via": {
      "enum": [
        "git",
        "api",
        "ui",
        "cli",
        "trigger",
        "template",
        "agent"
      ]
    },
    "rank": {
      "$ref": "common.schema.json#/$defs/rank"
    },
    "priority": {
      "enum": [
        "urgent",
        "high",
        "normal",
        "low"
      ]
    },
    "expedite": {
      "type": "boolean"
    },
    "ranked_by": {
      "$ref": "common.schema.json#/$defs/principal"
    },
    "ranked_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/refString"
      }
    },
    "approved_by": {
      "$ref": "common.schema.json#/$defs/principal"
    },
    "approved_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "capability_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "common.schema.json#/$defs/refString"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "by": {
            "$ref": "common.schema.json#/$defs/principal"
          },
          "at": {
            "$ref": "common.schema.json#/$defs/time"
          }
        },
        "required": [
          "ref",
          "digest",
          "by",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "cancel": {
      "$ref": "common.schema.json#/$defs/by"
    },
    "rejection": {
      "$ref": "common.schema.json#/$defs/by"
    },
    "previous": {
      "$ref": "common.schema.json#/$defs/refString"
    },
    "superseded": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "by": {
          "$ref": "common.schema.json#/$defs/refString"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "at",
        "by"
      ],
      "additionalProperties": false
    },
    "trigger": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/edge"
        }
      ],
      "properties": {
        "ref": {
          "$ref": "common.schema.json#/$defs/refString"
        },
        "on": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "fired_at": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "event": {
          "type": "object"
        }
      },
      "required": [
        "on",
        "fired_at"
      ],
      "additionalProperties": false
    },
    "attestation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*$"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thread": false,
    "runs": false,
    "placements": false,
    "task": false,
    "ref": false,
    "to": false,
    "id": false
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false,
  "required": [
    "kind",
    "schema",
    "definition",
    "definition_sha256",
    "state",
    "created_by",
    "created_at",
    "rank"
  ]
}
