{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/task.schema.json",
  "title": "A task grainfile (docs/grainfiles-spec.md §7.1)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requestor": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/requestor"
    },
    "recipient": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/deploymentIdentity"
    },
    "created_at": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/time"
    },
    "depends_on": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/refList"
    },
    "trigger_with": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/triggerWith"
    },
    "references": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/refList"
    }
  },
  "required": [
    "title",
    "requestor",
    "recipient"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
