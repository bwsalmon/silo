{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/task.schema.json",
  "title": "A task definition (docs/grainfiles-spec.md §7.1)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "submitter": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/identity"
    },
    "created_at": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/time"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/inputDecl"
      }
    },
    "context": {
      "type": "array",
      "items": {
        "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/contextEntry"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
      }
    },
    "implements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "ref"
        ]
      }
    },
    "lifecycle": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
    },
    "supersedes": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
    },
    "settings": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/settings"
    }
  },
  "required": [
    "title",
    "submitter",
    "created_at"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
