{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/trigger.schema.json",
  "title": "A trigger (docs/grainfiles-spec.md §7.5)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "on": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "object",
          "properties": {
            "cron": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "catch_up": {
              "enum": [
                "latest-only",
                "none"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "cron"
          ]
        },
        "design-change": {
          "type": "object",
          "properties": {
            "designs": {
              "type": "array",
              "items": {
                "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "designs"
          ]
        },
        "manual": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "push": {
          "type": "object",
          "properties": {
            "branches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ignore": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "paths"
          ]
        },
        "merge": {
          "type": "object",
          "properties": {
            "branches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ignore": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "paths"
          ]
        },
        "pull_request": {
          "type": "object",
          "properties": {
            "branches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ignore": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "paths"
          ]
        }
      },
      "minProperties": 1,
      "maxProperties": 1
    },
    "fires": {
      "type": "object",
      "properties": {
        "template": {
          "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
        },
        "definition": {
          "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
        },
        "workflow": {
          "type": "string"
        },
        "inputs": {
          "type": "object"
        },
        "per": {
          "enum": [
            "event",
            "requirement",
            "folder",
            "change"
          ]
        },
        "branch": {
          "type": "string"
        },
        "review": {
          "type": "object",
          "properties": {
            "template": {
              "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
            },
            "inputs": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "template"
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "template"
          ]
        },
        {
          "required": [
            "definition"
          ]
        },
        {
          "required": [
            "workflow"
          ]
        }
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "settings": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/settings"
    }
  },
  "required": [
    "on",
    "fires"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
