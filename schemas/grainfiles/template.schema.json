{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/template.schema.json",
  "title": "A template (docs/grainfiles-spec.md §7.4)",
  "type": "object",
  "properties": {
    "form": {
      "enum": [
        "task",
        "folder"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/inputDecl"
      }
    },
    "context": {
      "type": "array",
      "items": {
        "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/contextEntry"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
      }
    },
    "lifecycle": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
    },
    "settings": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/settings"
    }
  },
  "required": [
    "title"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
