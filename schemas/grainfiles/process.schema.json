{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/process.schema.json",
  "title": "A process grainfile (<name>.process.grain.md, docs/grainfiles-spec.md §7.2)",
  "type": "object",
  "properties": {
    "grainfile": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/grainfile"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requestor": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/requestor"
    },
    "recipient": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/deployment",
      "default": "/"
    },
    "draft": {
      "type": "boolean",
      "default": false
    },
    "not_before": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/notBefore"
    },
    "depends_on": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/refList"
    },
    "trigger_with": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/triggerWith"
    },
    "references": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/refList"
    },
    "when": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/when"
    },
    "gate": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "anyOf": [
    {
      "required": [
        "when"
      ]
    },
    {
      "required": [
        "trigger_with"
      ]
    }
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
