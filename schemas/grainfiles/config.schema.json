{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/config.schema.json",
  "title": "grain.config.md (docs/grainfiles-spec.md §10)",
  "type": "object",
  "properties": {
    "format": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "owner": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/identity"
    },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^h1:[A-Za-z0-9+/]{43}=$"
          }
        },
        "additionalProperties": false,
        "required": [
          "source"
        ]
      }
    },
    "check": {
      "type": "object",
      "properties": {
        "pinning": {
          "enum": [
            "warn",
            "required"
          ]
        },
        "limits": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/identity"
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "account"
      ]
    },
    "settings": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/settings"
    }
  },
  "required": [
    "format",
    "owner"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
