{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/moved.schema.json",
  "title": "A tombstone (docs/grainfiles-spec.md §7.10)",
  "type": "object",
  "properties": {
    "to": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
    },
    "moved_by": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/identity"
