{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/moved.schema.json",
  "title": "grain/moved@v1: a tombstone (\u00a77.12)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "moved"
    },
    "schema": {
      "const": "grain/moved@v1"
    },
    "aka": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moved_from": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/refString"
      }
    },
    "instantiated_from": {
      "type": "string",
      "pattern": "@[0-9a-f]{40}$"
    },
    "to": {
      "$ref": "common.schema.json#/$defs/refString"
    },
    "moved_by": {
      "$ref": "common.schema.json#/$defs/principal"
    },
    "moved_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "reason": {
      "type": "string"
    },
    "id": false
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false,
  "required": [
    "kind",
    "schema",
    "to",
    "moved_by",
    "moved_at"
  ]
}
