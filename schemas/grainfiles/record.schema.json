{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/record.schema.json",
  "title": "An execution record (docs/grainfiles-spec.md §13)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
    },
    "task": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "prompt"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "trigger": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/pinnedRef"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "nothing_needed",
        "refused"
      ]
    },
    "deployment": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/identity"
    },
    "started_at": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/time"
    },
    "finished_at": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/time"
    },
    "links": {
      "type": "object",
      "properties": {
        "pull_request": {
          "type": "string",
          "pattern": "^https://"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/sha"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "outcome",
    "deployment",
    "started_at",
    "finished_at"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
