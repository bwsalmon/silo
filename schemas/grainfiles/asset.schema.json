{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/asset.schema.json",
  "title": "grain/asset@v1: an asset's sidecar (\u00a77.15)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "asset"
    },
    "schema": {
      "const": "grain/asset@v1"
    },
    "aka": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moved_from": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/refString"
      }
    },
    "instantiated_from": {
      "type": "string",
      "pattern": "@[0-9a-f]{40}$"
    },
    "asset": {
      "$ref": "common.schema.json#/$defs/refString"
    },
    "external": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https|gs|s3)://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "sha256"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "alt": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer"
    },
    "id": false
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false,
  "required": [
    "kind",
    "schema"
  ],
  "oneOf": [
    {
      "required": [
        "asset"
      ]
    },
    {
      "required": [
        "external"
      ]
    }
  ]
}
