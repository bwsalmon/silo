{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/memory.schema.json",
  "title": "grain/memory@v1: guidance given to runs (\u00a77.11)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "memory"
    },
    "schema": {
      "const": "grain/memory@v1"
    },
    "aka": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moved_from": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/refString"
      }
    },
    "instantiated_from": {
      "type": "string",
      "pattern": "@[0-9a-f]{40}$"
    },
    "title": {
      "type": "string"
    },
    "applies_to": {
      "type": "object",
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "updated_by": {
      "$ref": "common.schema.json#/$defs/principal"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "id": false
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false,
  "required": [
    "kind",
    "schema",
    "title"
  ]
}
