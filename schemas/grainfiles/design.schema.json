{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/design.schema.json",
  "title": "A design (docs/grainfiles-spec.md §7.8)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/identity"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      }
    },
    "supersedes": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
    },
    "superseded_by": {
      "$ref": "https://grain.dev/schemas/grainfiles/common.schema.json#/$defs/ref"
    }
  },
  "required": [
    "title",
    "status",
    "owners",
    "requirements"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
