{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/repo.schema.json",
  "title": "grain/repo@v1: a task repo's README.md front matter, at the repo's root or in a folder such as .grain/; metadata only. role: grain-root marks a Grain's root (docs/task-repos.md §3, §3.2)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "repo"
    },
    "schema": {
      "const": "grain/repo@v1"
    },
    "role": {
      "type": "string",
      "description": "A convention: grain-root (a Grain's root folder, §3.2), intake, placements (Silo's per-Grain folders), shared, code, archive, ..."
    },
    "title": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "properties": {
        "team": {
          "type": "string"
        },
        "grain": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "silo": {
          "type": "string",
          "format": "uri"
        }
      },
      "minProperties": 1
    },
    "host": {
      "enum": [
        "silo",
        "local",
        "other"
      ]
    },
    "default_ref": {
      "type": "string",
      "default": "main"
    },
    "ref_policy": {
      "type": "object",
      "properties": {
        "protected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fast_forward_only": {
          "type": "boolean",
          "default": true
        },
        "review_prefix": {
          "type": "string"
        }
      }
    },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(https|ssh|file)://"
      }
    },
    "require_signed": {
      "type": "boolean",
      "default": false
    },
    "keys": {
      "description": "Signing keys per principal, for require_signed and the signed-commit upgrade (§11.8)",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "writers": {
      "description": "Write ownership (§3, §8.1). The common form is a list of principals: the folder's one writer, which may write any object in scope, still subject to schemas, path rules and state transitions. Only a folder that genuinely has several writers, which in this design is a team's intake, uses the ordered list of allow rules",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/principal"
          },
          "minItems": 1
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "who": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "may": {
                "oneOf": [
                  {
                    "enum": [
                      "create",
                      "update",
                      "delete",
                      "move"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "enum": [
                        "create",
                        "update",
                        "delete",
                        "move"
                      ]
                    }
                  }
                ]
              },
              "kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "repo",
                    "task",
                    "ref",
                    "run",
                    "comment",
                    "template",
                    "schedule",
                    "design",
                    "moved",
                    "trigger",
                    "suite",
                    "include",
                    "exclude",
                    "asset"
                  ]
                },
                "description": "Object kinds; asset also covers files that are not objects (docs/task-repos.md §2.2)"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fields": {
                "oneOf": [
                  {
                    "const": "*"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "where": {
                "type": "object"
              },
              "transition": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "from": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "to": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "field",
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              "merge_of": {
                "type": "string",
                "description": "The commit must be a merge whose second parent is the tip of a ref matching this glob, authored by someone other than the pusher (§8.11)"
              },
              "bind": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "forbid": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Refs this rule applies on; default: default_ref"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "who",
              "may"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      ]
    },
    "backlog": {
      "description": "The folders (globs allowed) that may hold this folder's own kind: ref files (§5.2). In a Grain root, its own lane; included lanes come from includes",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "backlog/"
      ]
    },
    "moved_to": {
      "description": "A repo-level redirect: this repo has moved to that URL (§2.1)",
      "type": "string",
      "pattern": "^(https|ssh|file)://"
    },
    "scope": {
      "description": "The subtrees this README governs, as paths from the repo root (/-rooted) or from the README's directory. Default: the README's own directory. A file is governed by the README whose scope entry covering it is longest (§3.1)",
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "task_home": {
      "description": "Where an approved task's definition lives (§5.5). A bare mode is shorthand for {mode: <mode>}. allow and repos are read from a team's intake README; path from a code repo's grain-folder README",
      "oneOf": [
        {
          "enum": [
            "intake",
            "code-repo",
            "promote"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "intake",
                "code-repo",
                "promote"
              ],
              "default": "intake"
            },
            "allow": {
              "type": "array",
              "items": {
                "enum": [
                  "intake",
                  "code-repo",
                  "promote"
                ]
              },
              "minItems": 1,
              "description": "Team only: the modes a code repo's own setting may choose. Default: all three"
            },
            "repos": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(https|ssh|file)://"
              },
              "additionalProperties": {
                "enum": [
                  "intake",
                  "code-repo",
                  "promote"
                ]
              },
              "description": "Team only: per-repo overrides, keyed by the code repo's git URL"
            },
            "path": {
              "type": "string",
              "default": "tasks/",
              "description": "Code repo only: the folder, relative to this README, that tasks are committed into"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "grain": {
      "description": "Required on a grain-root: the Grain whose root this folder is",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "silo": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "lanes": {
      "description": "Grain root only: the relative priority of the namespace's backlog lanes (§5.2). A lane is the folder holding a ref; an entry matches the lane it names and the folders under it",
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "strict",
            "weighted",
            "round_robin"
          ],
          "default": "strict",
          "description": "strict: the first listed lane with a runnable reference wins; weighted: smooth weighted round-robin over the lanes with a runnable reference; round_robin: weighted with every weight 1"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lane": {
                "$ref": "common.schema.json#/$defs/refString"
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              }
            },
            "required": [
              "lane"
            ],
            "additionalProperties": false
          }
        },
        "unlisted": {
          "enum": [
            "last",
            "ignore"
          ],
          "default": "last",
          "description": "Lanes the order does not name: after every listed lane, by name, or not dispatched at all"
        },
        "expedite": {
          "enum": [
            "lane",
            "global"
          ],
          "default": "lane",
          "description": "Whether Silo's expedite reorders only within its lane (default), or ahead of every lane"
        }
      },
      "additionalProperties": false
    },
    "include_limits": {
      "description": "Grain root only: lowers the resolver's limits (§3.3, §11.14); it can never raise them",
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "includes_per_space": {
          "type": "integer",
          "minimum": 1
        },
        "spaces": {
          "type": "integer",
          "minimum": 1
        },
        "repos": {
          "type": "integer",
          "minimum": 1
        },
        "objects": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schema",
    "role",
    "owner",
    "host",
    "writers"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "grain-root"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "grain"
        ]
      }
    }
  ]
}
