{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/repo.schema.json",
  "title": "grain/repo@v1: a task repo's README.md front matter, at the repo's root or in a grain folder such as .grain/ (docs/task-repos.md §3)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "repo"
    },
    "schema": {
      "const": "grain/repo@v1"
    },
    "role": {
      "type": "string",
      "description": "A convention: grain, intake, shared, code, archive, ..."
    },
    "title": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "properties": {
        "team": {
          "type": "string"
        },
        "grain": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "silo": {
          "type": "string",
          "format": "uri"
        }
      },
      "minProperties": 1
    },
    "host": {
      "enum": [
        "silo",
        "local",
        "other"
      ]
    },
    "default_ref": {
      "type": "string",
      "default": "main"
    },
    "ref_policy": {
      "type": "object",
      "properties": {
        "protected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fast_forward_only": {
          "type": "boolean",
          "default": true
        },
        "review_prefix": {
          "type": "string"
        }
      }
    },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(https|ssh|file)://"
      }
    },
    "require_signed": {
      "type": "boolean",
      "default": false
    },
    "keys": {
      "description": "Signing keys per principal, for require_signed and the signed-commit upgrade (§11.8)",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "writers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "who": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "may": {
            "oneOf": [
              {
                "enum": [
                  "create",
                  "update",
                  "delete",
                  "move"
                ]
              },
              {
                "type": "array",
                "items": {
                  "enum": [
                    "create",
                    "update",
                    "delete",
                    "move"
                  ]
                }
              }
            ]
          },
          "kinds": {
            "type": "array",
            "items": {
              "enum": [
                "repo",
                "task",
                "ref",
                "run",
                "comment",
                "template",
                "schedule",
                "design",
                "moved",
                "trigger",
                "suite"
              ]
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "oneOf": [
              {
                "const": "*"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "where": {
            "type": "object"
          },
          "transition": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "field",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "merge_of": {
            "type": "string",
            "description": "The commit must be a merge whose second parent is the tip of a ref matching this glob, authored by someone other than the pusher (§8.11)"
          },
          "bind": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "forbid": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Refs this rule applies on; default: default_ref"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "who",
          "may"
        ],
        "additionalProperties": false
      }
    },
    "backlog": {
      "description": "The folders whose kind: ref files are this repo's queue (§5.2)",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "backlog/"
      ]
    },
    "moved_to": {
      "description": "A repo-level redirect: this repo has moved to that URL (§2.1)",
      "type": "string",
      "pattern": "^(https|ssh|file)://"
    },
    "scope": {
      "description": "The subtrees this README governs, as paths from the repo root (/-rooted) or from the README's directory. Default: the README's own directory. A file is governed by the README whose scope entry covering it is longest (§3.1)",
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "task_home": {
      "description": "Where an approved task's definition lives (§5.5). A bare mode is shorthand for {mode: <mode>}. allow and repos are read from a team's intake README; path from a code repo's grain-folder README",
      "oneOf": [
        {
          "enum": [
            "intake",
            "code-repo",
            "promote"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "intake",
                "code-repo",
                "promote"
              ],
              "default": "intake"
            },
            "allow": {
              "type": "array",
              "items": {
                "enum": [
                  "intake",
                  "code-repo",
                  "promote"
                ]
              },
              "minItems": 1,
              "description": "Team only: the modes a code repo's own setting may choose. Default: all three"
            },
            "repos": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(https|ssh|file)://"
              },
              "additionalProperties": {
                "enum": [
                  "intake",
                  "code-repo",
                  "promote"
                ]
              },
              "description": "Team only: per-repo overrides, keyed by the code repo's git URL"
            },
            "path": {
              "type": "string",
              "default": "tasks/",
              "description": "Code repo only: the folder, relative to this README, that tasks are committed into"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "schedules": {
      "description": "Intake only: the schedules outside Silo's own repos that this team adopts. A schedule that names a team fires for it only if adopted here (§6.2, §11.13)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "common.schema.json#/$defs/refString"
          },
          "auto_approve": {
            "type": "object",
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "digest"
            ],
            "additionalProperties": false,
            "description": "Firings are filed approved only while the schedule and the template it names still hash to this digest; otherwise they are filed proposed"
          }
        },
        "required": [
          "ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schema",
    "role",
    "owner",
    "host",
    "writers"
  ]
}
