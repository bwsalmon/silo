{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/schedule.schema.json",
  "title": "grain/schedule@v1: a cadence that files a templated task (docs/task-repos.md §6.2); next/last run times are runtime only",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/cadence"
    }
  ],
  "properties": {
    "kind": {
      "const": "schedule"
    },
    "schema": {
      "const": "grain/schedule@v1"
    },
    "aka": {
      "$ref": "common.schema.json#/$defs/aka"
    },
    "title": {
      "type": "string"
    },
    "template": {
      "$ref": "common.schema.json#/$defs/refString"
    },
    "inputs": {
      "$ref": "common.schema.json#/$defs/inputValues"
    },
    "overlap": {
      "enum": [
        "skip",
        "queue",
        "allow"
      ]
    },
    "timezone": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "base": {
      "type": "string"
    },
    "team": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "derived_from": {
      "$ref": "common.schema.json#/$defs/refString",
      "description": "Provenance only: the schedule this one was customised from, which the same root excludes (§6.2). A reference: it adds no name to any namespace and inherits nothing"
    },
    "fires_in": {
      "enum": [
        "silo",
        "grain"
      ],
      "description": "Who fires it: silo files into the team intake; grain means every Grain whose namespace contains it fires it into its own root. A Grain lists a silo schedule in its namespace but never fires it"
    },
    "auto_approve_proposals": {
      "type": "boolean"
    },
    "auto_merge": {
      "type": "boolean"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "next_run_at": false,
    "last_run_at": false,
    "moved_from": {
      "$ref": "common.schema.json#/$defs/movedFrom"
    }
  },
  "required": [
    "kind",
    "schema",
    "template"
  ]
}
