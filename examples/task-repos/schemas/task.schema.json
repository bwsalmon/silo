{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/task.schema.json",
  "title": "grain/task@v1: one task; its body is the prompt (docs/task-repos.md §5)",
  "type": "object",
  "properties": {
    "kind": {"const": "task"},
    "schema": {"const": "grain/task@v1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "aka": {"$ref": "common.schema.json#/$defs/aka"},
    "title": {"type": "string", "minLength": 1},
    "team": {"type": "string"},
    "repo": {"type": "string", "description": "The code repo the work lands in, as a git URL; absent for a team-targeted task"},
    "base": {"type": "string"},
    "state": {"enum": ["proposed", "rejected", "approved", "placed", "running", "refused", "done", "failed", "cancelled", "moved"]},
    "submitter": {"$ref": "common.schema.json#/$defs/principal"},
    "submitted_via": {"enum": ["git", "api", "ui", "cli", "schedule", "planning", "agent"]},
    "approved_by": {"$ref": "common.schema.json#/$defs/principal"},
    "approved_at": {"$ref": "common.schema.json#/$defs/time"},
    "rejection": {"type": "object", "properties": {"by": {"type": "string"}, "at": {"type": "string"}, "reason": {"type": "string"}}},
    "origin": {"type": "string", "description": "What this work comes from: a ref, or an existing Origin: value (task 4193, owner/repo#N)"},
    "filed_by": {
      "type": "object",
      "properties": {
        "grain": {"type": "string"},
        "task": {"$ref": "common.schema.json#/$defs/ref"},
        "principal": {"$ref": "common.schema.json#/$defs/principal"}
      }
    },
    "created_at": {"$ref": "common.schema.json#/$defs/time"},
    "labels": {"type": "array", "items": {"type": "string"}},
    "constraints": {
      "type": "object",
      "properties": {"labels": {"type": "object", "additionalProperties": {"type": "string"}}, "node": {"type": "string"}}
    },
    "capabilities": {
      "description": "Names of capabilities requested; never secret material (§11.6)",
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:/._-]*$"}
    },
    "auto_merge": {"type": "boolean"},
    "template": {
      "allOf": [{"$ref": "common.schema.json#/$defs/ref"}],
      "properties": {"rev": {"$ref": "common.schema.json#/$defs/sha"}, "inputs": {"$ref": "common.schema.json#/$defs/inputValues"}}
    },
    "schedule": {
      "allOf": [{"$ref": "common.schema.json#/$defs/ref"}],
      "properties": {"fired_at": {"$ref": "common.schema.json#/$defs/time"}}
    },
    "depends_on": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/ref"}},
    "supersedes": {"$ref": "common.schema.json#/$defs/ref"},
    "implements": {
      "type": "array",
      "items": {
        "allOf": [{"$ref": "common.schema.json#/$defs/ref"}],
        "properties": {
          "rev": {"$ref": "common.schema.json#/$defs/sha"},
          "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "required": ["rev", "hash"]
      }
    },
    "placement": {
      "type": "object",
      "properties": {
        "grain": {"type": "string"},
        "ref": {"$ref": "common.schema.json#/$defs/refString"},
        "generation": {"type": "integer", "minimum": 1},
        "at": {"$ref": "common.schema.json#/$defs/time"},
        "intake": {"$ref": "common.schema.json#/$defs/ref"},
        "previous": {"$ref": "common.schema.json#/$defs/ref"}
      },
      "required": ["grain", "generation", "at"]
    },
    "attestation": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*$", "description": "The hub's signed claims JWT (hub.md §6.4)"},
    "refusal": {"type": "object", "properties": {"reason": {"type": "string"}, "at": {"type": "string"}}, "required": ["reason"]},
    "cancel": {"type": "object", "properties": {"by": {"type": "string"}, "at": {"type": "string"}, "reason": {"type": "string"}}, "required": ["by", "at"]},
    "moved_to": {"$ref": "common.schema.json#/$defs/ref"},
    "closed": {
      "description": "The final-state snapshot, written once by the Grain (§1.2, §8.5)",
      "type": "object",
      "properties": {
        "outcome": {"enum": ["done", "failed", "cancelled", "nothing_needed"]},
        "at": {"$ref": "common.schema.json#/$defs/time"},
        "summary": {"type": "string"},
        "change": {
          "type": "object",
          "properties": {
            "url": {"type": "string"},
            "branch": {"type": "string"},
            "merge_commit": {"$ref": "common.schema.json#/$defs/sha"},
            "commits": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sha"}}
          }
        },
        "design_revs": {
          "type": "array",
          "items": {"type": "object", "properties": {"item": {"type": "string"}, "rev": {"$ref": "common.schema.json#/$defs/sha"}, "hash": {"type": "string"}}, "required": ["item", "rev"]}
        },
        "follow_ups": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/ref"}}
      },
      "required": ["outcome", "at"]
    }
  },
  "required": ["kind", "schema", "id", "title", "state", "submitter", "created_at"],
  "allOf": [
    {"if": {"properties": {"state": {"const": "approved"}}}, "then": {"required": ["approved_by", "approved_at"]}},
    {"if": {"properties": {"state": {"enum": ["placed", "running", "refused", "done", "failed", "cancelled"]}}}, "then": {"required": ["placement"]}},
    {"if": {"properties": {"state": {"const": "moved"}}}, "then": {"required": ["moved_to"]}},
    {"if": {"properties": {"state": {"enum": ["done", "failed", "cancelled"]}}}, "then": {"required": ["closed"]}}
  ]
}
