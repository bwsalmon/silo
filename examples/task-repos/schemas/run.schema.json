{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/run.schema.json",
  "title": "grain/run@v1: one Grain's execution record of one placement of a task, in that Grain's own repo (docs/task-repos.md §5.3)",
  "type": "object",
  "properties": {
    "kind": {"const": "run"},
    "schema": {"const": "grain/run@v1"},
    "aka": {"$ref": "common.schema.json#/$defs/aka"},
    "task": {"$ref": "common.schema.json#/$defs/pinnedRef", "description": "The task, and the commit of it that was run"},
    "from": {"$ref": "common.schema.json#/$defs/pinnedRef", "description": "The backlog reference it came from, and the commit of this repo it was read at"},
    "previous": {"$ref": "common.schema.json#/$defs/refString", "description": "The superseded run this one replaces, after re-placement (§8.8)"},
    "grain": {"type": "string"},
    "state": {"enum": ["accepted", "running", "waiting", "done", "failed", "refused", "cancelled", "superseded"]},
    "accepted_at": {"$ref": "common.schema.json#/$defs/time"},
    "started_at": {"$ref": "common.schema.json#/$defs/time"},
    "refusal": {"type": "object", "properties": {"reason": {"type": "string"}, "at": {"type": "string"}}, "required": ["reason"]},
    "superseded": {
      "description": "Silo's, written only once the run's backlog reference is gone (§8.8)",
      "type": "object",
      "properties": {"at": {"$ref": "common.schema.json#/$defs/time"}, "by": {"$ref": "common.schema.json#/$defs/principal"}, "reason": {"type": "string"}},
      "required": ["at", "by"]
    },
    "closed": {
      "description": "The final-state snapshot, written once by the Grain (§1.2, §8.5)",
      "type": "object",
      "properties": {
        "outcome": {"enum": ["done", "failed", "cancelled", "nothing_needed"]},
        "at": {"$ref": "common.schema.json#/$defs/time"},
        "summary": {"type": "string"},
        "change": {
          "type": "object",
          "properties": {
            "url": {"type": "string"},
            "branch": {"type": "string"},
            "merge_commit": {"$ref": "common.schema.json#/$defs/sha"},
            "commits": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sha"}}
          }
        },
        "design_revs": {
          "type": "array",
          "items": {"type": "object", "properties": {"item": {"type": "string"}, "rev": {"$ref": "common.schema.json#/$defs/sha"}, "hash": {"type": "string"}}, "required": ["item", "rev"]}
        },
        "follow_ups": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/refString"}}
      },
      "required": ["outcome", "at"]
    }
  },
  "required": ["kind", "schema", "task", "from", "grain", "state", "accepted_at"],
  "allOf": [
    {"if": {"properties": {"state": {"const": "refused"}}}, "then": {"required": ["refusal"]}},
    {"if": {"properties": {"state": {"const": "superseded"}}}, "then": {"required": ["superseded"]}},
    {"if": {"properties": {"state": {"enum": ["done", "failed", "cancelled"]}}}, "then": {"required": ["closed"]}}
  ]
}
