{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/run.schema.json",
  "title": "grain/run@v1: one Grain's execution record of one placement of a task, in that Grain's own repo (docs/task-repos.md §5.3)",
  "type": "object",
  "properties": {
    "kind": {"const": "run"},
    "schema": {"const": "grain/run@v1"},
    "aka": {"$ref": "common.schema.json#/$defs/aka"},
    "task": {"$ref": "common.schema.json#/$defs/pinnedRef", "description": "The task, and the commit of it that was run"},
    "from": {"$ref": "common.schema.json#/$defs/pinnedRef", "description": "The backlog reference it came from, in the Grain's own lane or an included one such as Silo's placements, and the commit of that reference's repo it was read at"},
    "previous": {"$ref": "common.schema.json#/$defs/refString", "description": "The superseded run this one replaces, after re-placement (§8.8)"},
    "grain": {"type": "string"},
    "state": {"enum": ["accepted", "running", "waiting", "done", "failed", "refused", "cancelled", "superseded"]},
    "accepted_at": {"$ref": "common.schema.json#/$defs/time"},
    "started_at": {"$ref": "common.schema.json#/$defs/time"},
    "refusal": {"type": "object", "properties": {"reason": {"type": "string"}, "at": {"type": "string"}, "entry": {"$ref": "#/$defs/entryRef"}, "secret": {"type": "string"}}, "required": ["reason"]},
    "waiting": {"type": "object", "description": "Why a run is held (§5.3); on: policy names the context entry the Grain's policy refused (§5.6); on: secret names a secret a capability needs that the Grain's store lacks, and on: human a capability approval (§5.7)", "properties": {"on": {"enum": ["dependency", "human", "gate", "policy", "secret"]}, "entry": {"$ref": "#/$defs/entryRef"}, "reason": {"type": "string"}, "secret": {"type": "string"}}, "required": ["on"]},
    "context": {
      "description": "What the Grain materialised in the sandbox, and what it skipped, written with the running commit (§5.6)",
      "type": "object",
      "properties": {
        "entries": {"type": "array", "items": {"type": "object", "properties": {"ref": {"$ref": "common.schema.json#/$defs/refString"}, "via": {"$ref": "common.schema.json#/$defs/refString"}, "mode": {"enum": ["read", "write"]}, "rev": {"$ref": "common.schema.json#/$defs/sha"}, "path": {"type": "string"}, "branch": {"type": "string"}, "bytes": {"type": "integer"}}, "required": ["ref", "mode", "rev", "path"]}},
        "skipped": {"type": "array", "items": {"type": "object", "properties": {"ref": {"type": "string"}, "via": {"$ref": "common.schema.json#/$defs/refString"}, "reason": {"type": "string"}}, "required": ["ref", "reason"]}},
        "limits": {"type": "object"}
      },
      "required": ["entries"]
    },
    "capabilities": {
      "description": "Each capability the run used, as the Grain resolved and materialised it, written with the running commit (§5.7). Names of secrets only, never material",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry": {"type": "integer", "minimum": 1},
          "ref": {"$ref": "common.schema.json#/$defs/refString"},
          "chain": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/pinnedRef"}, "description": "Base-most first"},
          "base": {"type": "object", "properties": {"type": {"type": "string"}, "declaration": {"$ref": "common.schema.json#/$defs/pinnedRef"}}, "required": ["type"]},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "effective": {"type": "object"},
          "implies": {"type": "object"},
          "materialised": {"type": "array", "items": {"type": "string"}},
          "secrets": {"type": "array", "items": {"type": "string"}},
          "approved": {"type": "object", "properties": {"by": {"type": "string"}, "at": {"type": "string"}, "via": {"enum": ["task", "attestation", "local"]}}},
          "denials": {"type": "integer", "minimum": 0, "description": "Per-use denials during the run, written at close; each is in the Grain's audit log"}
        },
        "required": ["entry", "ref", "chain", "base", "digest", "effective"]
      }
    },
    "superseded": {
      "description": "Written by the Grain itself, the only writer of its root, once it sees that Silo withdrew the run's placement (§8.8). Until then readers treat the open run as fenced",
      "type": "object",
      "properties": {"at": {"$ref": "common.schema.json#/$defs/time"}, "by": {"$ref": "common.schema.json#/$defs/principal"}, "withdrawn_at": {"$ref": "common.schema.json#/$defs/time", "description": "When Silo removed the placement, from Silo's own repo"}, "reason": {"type": "string"}},
      "required": ["at", "by"]
    },
    "closed": {
      "description": "The final-state snapshot, written once by the Grain (§1.2, §8.5)",
      "type": "object",
      "properties": {
        "outcome": {"enum": ["done", "failed", "cancelled", "nothing_needed"]},
        "at": {"$ref": "common.schema.json#/$defs/time"},
        "summary": {"type": "string"},
        "change": {
          "description": "The change in the primary repo; a list, one per repo, when the run pushed to several write entries (§5.6)",
          "oneOf": [{"$ref": "#/$defs/change"}, {"type": "array", "items": {"$ref": "#/$defs/change"}}]
        },
        "design_revs": {
          "type": "array",
          "items": {"type": "object", "properties": {"item": {"type": "string"}, "rev": {"$ref": "common.schema.json#/$defs/sha"}, "hash": {"type": "string"}}, "required": ["item", "rev"]}
        },
        "follow_ups": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/refString"}}
      },
      "required": ["outcome", "at"]
    }
  },
  "$defs": {
    "change": {
      "type": "object",
      "properties": {
        "repo": {"type": "string"},
        "url": {"type": "string"},
        "branch": {"type": "string"},
        "merge_commit": {"$ref": "common.schema.json#/$defs/sha"},
        "commits": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sha"}}
      }
    },
    "entryRef": {"type": "object", "description": "A context entry, by its 1-based index in the task's context: and its reference; for a capability, the link of its chain and the reducer or implication that decided (§5.7)", "properties": {"index": {"type": "integer", "minimum": 1}, "ref": {"type": "string"}, "mode": {"enum": ["read", "write", "use"]}, "rule": {"type": "string"}, "link": {"type": "string"}, "reducer": {"type": "integer", "minimum": 1}}, "required": ["index", "ref"]}
  },
  "required": ["kind", "schema", "task", "from", "grain", "state", "accepted_at"],
  "allOf": [
    {"if": {"properties": {"state": {"const": "refused"}}}, "then": {"required": ["refusal"]}},
    {"if": {"properties": {"state": {"const": "superseded"}}}, "then": {"required": ["superseded"]}},
    {"if": {"properties": {"state": {"const": "waiting"}}}, "then": {"required": ["waiting"]}},
    {"if": {"properties": {"state": {"enum": ["done", "failed", "cancelled"]}}}, "then": {"required": ["closed"]}}
  ]
}
