{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/comment.schema.json",
  "title": "grain/comment@v1: one comment, on a run's thread or on a task (docs/task-repos.md §5.4)",
  "type": "object",
  "properties": {
    "kind": {
      "const": "comment"
    },
    "schema": {
      "const": "grain/comment@v1"
    },
    "aka": {
      "$ref": "common.schema.json#/$defs/aka"
    },
    "task": {
      "$ref": "common.schema.json#/$defs/refString",
      "description": "Discussion of the task itself (§5.4)"
    },
    "author": {
      "$ref": "common.schema.json#/$defs/principal"
    },
    "via": {
      "$ref": "common.schema.json#/$defs/principal"
    },
    "at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "in_reply_to": {
      "$ref": "common.schema.json#/$defs/refString"
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/refString"
    },
    "run": {
      "$ref": "common.schema.json#/$defs/refString",
      "description": "The thread of one execution record (§5.4)"
    }
  },
  "required": [
    "kind",
    "schema",
    "author",
    "at"
  ],
  "oneOf": [
    {
      "required": [
        "run"
      ]
    },
    {
      "required": [
        "task"
      ]
    }
  ]
}
