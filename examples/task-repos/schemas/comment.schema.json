{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/comment.schema.json",
  "title": "grain/comment@v1: one comment on a task's thread (docs/task-repos.md §5.2)",
  "type": "object",
  "properties": {
    "kind": {"const": "comment"},
    "schema": {"const": "grain/comment@v1"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "aka": {"$ref": "common.schema.json#/$defs/aka"},
    "task": {"$ref": "common.schema.json#/$defs/ref"},
    "author": {"$ref": "common.schema.json#/$defs/principal"},
    "via": {"$ref": "common.schema.json#/$defs/principal"},
    "at": {"$ref": "common.schema.json#/$defs/time"},
    "in_reply_to": {"$ref": "common.schema.json#/$defs/ref"},
    "supersedes": {"$ref": "common.schema.json#/$defs/ref"}
  },
  "required": ["kind", "schema", "id", "task", "author", "at"]
}
