{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/common.schema.json",
  "title": "Definitions shared by every task-repo kind (docs/task-repos.md)",
  "$defs": {
    "refString": {
      "description": "A reference, which names its target by path (docs/task-repos.md §2.1, §4): a relative or /-rooted path, <git URL>//<path>, or <alias>:<path>; then optional @<gitref> and #<anchor>",
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^[^/:@]+@[^/:]+:"
      }
    },
    "ref": {
      "description": "An edge that records more than its target: the reference in `ref`, plus the edge's own fields (§4)",
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/refString"
        }
      },
      "required": [
        "ref"
      ]
    },
    "principal": {
      "description": "Who: silo, silo:schedule, grain:<node>, user:<email>, agent:grain:<node>/<run path>, team:<name>#member|approver|admin|maintainer, authenticated",
      "type": "string",
      "pattern": "^(silo(:schedule)?|grain:[a-z0-9][a-z0-9-]*|user:[^@\\s]+@[^@\\s]+|agent:grain:[a-z0-9-]+/[a-z0-9./-]+|team:[a-z0-9-]+#(member|approver|admin|maintainer)|authenticated)$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "aka": {
      "description": "Earlier identities from before migration (grain:<deployment>/task/<n>, a settings id, a hub task id): indexed for search, never used to resolve (§2.1)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputValues": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean",
          "array"
        ]
      }
    },
    "cadence": {
      "description": "The cadence keys grain's declarations use (docs/declarations.md); exactly one of them",
      "type": "object",
      "properties": {
        "hourly": {
          "type": "object"
        },
        "every": {
          "type": "object"
        },
        "daily": {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          },
          "required": [
            "at"
          ]
        },
        "weekly": {
          "type": "object",
          "properties": {
            "day": {
              "enum": [
                "monday",
                "tuesday",
                "wednesday",
                "thursday",
                "friday",
                "saturday",
                "sunday"
              ]
            },
            "at": {
              "type": "string"
            }
          },
          "required": [
            "day",
            "at"
          ]
        },
        "monthly": {
          "type": "object"
        },
        "cron": {
          "type": "string"
        }
      }
    },
    "pinnedRef": {
      "description": "A reference plus the commit it was read at, so it still resolves after the target is gone (§4)",
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/refString"
        },
        "rev": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "ref",
        "rev"
      ]
    },
    "movedFrom": {
      "description": "The object's earlier addresses, oldest first; each is now a kind: moved tombstone (§2.1)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/refString"
      },
      "minItems": 1
    },
    "rank": {
      "description": "LexoRank-style key over 0-9a-z, compared bytewise, never ending in 0 (§5.2)",
      "type": "string",
      "pattern": "^[0-9a-z]*[1-9a-z]$"
    },
    "priority": {
      "enum": [
        "urgent",
        "high",
        "normal",
        "low"
      ],
      "default": "normal"
    }
  }
}
