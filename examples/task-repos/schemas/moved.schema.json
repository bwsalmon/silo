{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/task-repos/moved.schema.json",
  "title": "grain/moved@v1: a tombstone at an object's old path; readers follow it like an HTTP redirect, and the path is never reused (docs/task-repos.md §2.1)",
  "type": "object",
  "properties": {
    "kind": {"const": "moved"},
    "schema": {"const": "grain/moved@v1"},
    "to": {"$ref": "common.schema.json#/$defs/refString", "description": "The new address, relative to this file or across repos"},
    "moved_by": {"$ref": "common.schema.json#/$defs/principal"},
    "moved_at": {"$ref": "common.schema.json#/$defs/time"},
    "reason": {"type": "string"}
  },
  "required": ["kind", "schema", "to", "moved_by", "moved_at"],
  "additionalProperties": false
}
