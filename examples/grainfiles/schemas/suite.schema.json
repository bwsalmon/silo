{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grain.dev/schemas/grainfiles/suite.schema.json",
  "title": "grain/suite@v1: a .grain/suites declaration as Markdown; its keys are pkg/declschema's, verbatim, and the body is its description (docs/grainfiles.md §9.3)",
  "type": "object",
  "properties": {
    "kind": {"const": "suite"},
    "schema": {"const": "grain/suite@v1"},
    "aka": {"$ref": "common.schema.json#/$defs/aka"},
    "moved_from": {"$ref": "common.schema.json#/$defs/movedFrom"},
    "title": {"type": "string"},
    "reads": false,
    "writes": false,
    "grants": false,
    "target": false
  },
  "required": ["kind", "schema"]
}
