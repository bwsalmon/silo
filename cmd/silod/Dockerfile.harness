# The harness image: what agents' session containers on the control VM
# run (docs/silo/agents.md, §3 and §11). It pins both adapters' CLIs,
# Claude Code and Codex, at the versions package agents ships
# (agents.Adapters), and carries silod for its harness-init entrypoint
# and the pause that holds a session's network namespace, and iptables
# for the one-shot container that drops the metadata server in it.
# Build it from the repository root, beside silod's image:
#
#   make silod-harness-image
#
# and install pushes nothing: silo install copies it into the project,
# by digest, as it copies silod's, with --agent-sessions.
#
# Every container of it runs as a session's own unprivileged uid, with
# no capabilities and a read-only root (package harness), except the
# firewall container, which has NET_ADMIN and runs nothing but the
# rules.
ARG GO_VERSION=1.26.6
ARG GO_IMAGE=golang
ARG GO_IMAGE_DIGEST=sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36
ARG NODE_IMAGE_DIGEST=sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

FROM --platform=$BUILDPLATFORM ${GO_IMAGE}:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS builder

WORKDIR /src

ARG GOPROXY
ARG TARGETOS
ARG TARGETARCH
ARG RELEASE=dev

COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -buildvcs=false -trimpath \
    -ldflags="-s -w -X main.release=${RELEASE}" -o /out/silod ./cmd/silod

FROM node:22-bookworm-slim@${NODE_IMAGE_DIGEST}

# The adapters' CLIs, pinned (agents.Adapters: claude-code 2.1.4,
# codex 0.46.0). Bump them there and here together.
ARG CLAUDE_CODE_VERSION=2.1.4
ARG CODEX_VERSION=0.46.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends iptables ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --no-fund --no-audit \
        @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
        @openai/codex@${CODEX_VERSION} \
    && npm cache clean --force \
    && claude --version && codex --version

COPY --from=builder /out/silod /usr/local/bin/silod

# Sessions run as their own uid, given by sessiond; this is only the
# default for anything else.
USER nobody:nogroup

ENTRYPOINT ["/usr/local/bin/silod", "harness-init"]
