run
-d
--name
granule-vm-c2
--label
granule.dev/vm=c2
--device
/dev/kvm
--device
/dev/net/tun
--cap-drop
ALL
--cap-add
NET_ADMIN
--security-opt
no-new-privileges
-e
CHV_DISK_MODE=overlay
-v
/wraps/sha256-0123:/var/lib/granule/guest:ro
-v
/io/c2:/run/silo
-e
CHV_DISK_SIZE_MB=20480
-e
CHV_CMDLINE=console=ttyS0 root=/dev/vda rw noresume quiet loglevel=3
-e
CHV_NET_MODE=inline
-e
NETSHIM_VM=c2
-e
NETSHIM_BRIDGE=granule0
-e
NETSHIM_CONTROL_CIDR=
-e
NETSHIM_EXTERNAL_IFACE=auto
-e
NETSHIM_DNS=10.88.4.1
-e
NETSHIM_IPV6=off
-e
CHV_CPUS=3
-e
CHV_MEMORY_MB=2048
-e
CHV_SHUTDOWN_TIMEOUT=10s
-e
CHV_CONTAINER_OVERRIDE={"entrypoint":["bash"],"cmd":[],"env":["TERM=xterm"]}
-e
GRANULE_WORKLOAD_STDOUT=/run/silo/stdout
-e
GRANULE_WORKLOAD_EXIT_FILE=/run/silo/exit.json
-e
GRANULE_WORKLOAD_STDIN=/run/silo/stdin
-e
GRANULE_WORKLOAD_TTY=true
-e
GRANULE_WORKLOAD_RESIZE=/run/silo/resize
-e
CHV_VOLUMES=tag=v0,socket=/run/silo/fs/v0.sock,destination=/data;tag=v1,socket=/run/silo/fs/v1.sock,destination=/etc/app,readonly=on
silo-granule
run
