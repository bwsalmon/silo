run
-d
--name
granule-vm-c1
--label
granule.dev/vm=c1
--device
/dev/kvm
--device
/dev/net/tun
--cap-drop
ALL
--cap-add
NET_ADMIN
--security-opt
no-new-privileges
-e
CHV_DISK_MODE=overlay
-v
/wraps/sha256-0123:/var/lib/granule/guest:ro
-v
/io/c1:/run/silo
-e
CHV_DISK_SIZE_MB=10240
-e
CHV_CMDLINE=console=ttyS0 root=/dev/vda rw noresume quiet loglevel=3
-e
CHV_NET_MODE=inline
-e
NETSHIM_VM=c1
-e
NETSHIM_BRIDGE=granule0
-e
NETSHIM_CONTROL_CIDR=
-e
NETSHIM_EXTERNAL_IFACE=auto
-e
NETSHIM_DNS=10.88.0.1
-e
NETSHIM_IPV6=off
-e
CHV_CPUS=1
-e
CHV_MEMORY_MB=512
-e
CHV_SHUTDOWN_TIMEOUT=10s
-e
CHV_CONTAINER_OVERRIDE={"entrypoint":["/bin/sh","-c","echo hi"],"cmd":[],"env":["PATH=/usr/bin:/bin","A=b"],"user":"1000:1000","working_dir":"/srv"}
-e
GRANULE_WORKLOAD_STDOUT=/run/silo/stdout
-e
GRANULE_WORKLOAD_STDERR=/run/silo/stderr
-e
GRANULE_WORKLOAD_EXIT_FILE=/run/silo/exit.json
silo-granule
run
