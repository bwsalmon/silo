{
  "$id": "https://github.com/bwsalmon/silo/v2/silofile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A Silo v2 Silofile (design §2.3). Generated from the Go types in github.com/bwsalmon/silo/v2/silofile; do not edit.",
  "properties": {
    "agent": {
      "additionalProperties": false,
      "description": "The agent CLI and how it runs (design §6).",
      "properties": {
        "auth": {
          "description": "ambient (the CLI's own login, the default) or {credential: \u003cname\u003e}.",
          "oneOf": [
            {
              "enum": [
                "ambient"
              ],
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "credential": {
                  "type": "string"
                }
              },
              "required": [
                "credential"
              ],
              "type": "object"
            }
          ]
        },
        "binary": {
          "description": "Path of the CLI on the agent host; otherwise found on PATH there.",
          "type": "string"
        },
        "cli": {
          "description": "claude | codex | agy | custom",
          "type": "string"
        },
        "custom": {
          "additionalProperties": false,
          "description": "Only for cli: custom (cli-mapping.md §2.4).",
          "properties": {
            "argv": {
              "additionalProperties": false,
              "properties": {
                "attached": {
                  "description": "Later.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "headless": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "interactive": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "events": {
              "description": "How silo parses headless output: claude-stream-json, or none.",
              "type": "string"
            },
            "mcp_config": {
              "additionalProperties": false,
              "properties": {
                "arg": {
                  "description": "Arguments naming the file, with {file} substituted.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "env": {
                  "description": "Or an environment variable naming the file.",
                  "type": "string"
                },
                "format": {
                  "description": "claude-json | codex-toml | stdio-bridge",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "permissions": {
              "additionalProperties": false,
              "properties": {
                "all": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "none": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "effort": {
          "description": "Passed where the CLI has a flag for it.",
          "type": "string"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "deadline": {
              "description": "Wall clock, after which the session is ended. A duration: number-and-unit pairs (w, d, h, m, s), such as 7d or 1h30m; 0 is zero.",
              "pattern": "^(0|([0-9]+[wdhms])+)$",
              "type": [
                "string",
                "integer"
              ]
            },
            "max_turns": {
              "description": "Where the CLI supports it.",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "mode": {
          "description": "interactive (default) | headless | attached (later)",
          "type": "string"
        },
        "model": {
          "description": "The CLI's default otherwise.",
          "type": "string"
        },
        "prompt": {
          "description": "Inline text, or a file in the silo folder (a single line with no whitespace is read as a path). Required for headless.",
          "type": "string"
        },
        "system_prompt": {
          "description": "Appended to the CLI's own; inline text or a file, as prompt.",
          "type": "string"
        },
        "workdir": {
          "description": "On the agent host. Default: a private empty directory.",
          "type": "string"
        }
      },
      "required": [
        "cli"
      ],
      "type": "object"
    },
    "builtin_tools": {
      "description": "Built-in silos only (silo create). Refused in a user Silofile.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "credentials": {
      "description": "Secrets, where they come from and where they go (design §8).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "additionalProperties": false,
            "description": "Exactly one of env, file, store, ambient.",
            "properties": {
              "ambient": {
                "description": "gh | git-credential | gcloud (gcloud is silo's own and is never delivered).",
                "type": "string"
              },
              "env": {
                "description": "A variable of the invoking environment.",
                "type": "string"
              },
              "file": {
                "description": "A file on the invoking machine; may be absolute or ~/...",
                "type": "string"
              },
              "store": {
                "description": "A name in silo's secret store.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "to": {
            "description": "Where the credential is delivered; at least one, unless agent.auth names it.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "agent": {
                  "description": "env: set in the agent CLI's own environment.",
                  "type": "string"
                },
                "env": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "local": {
                  "description": "A local-executor script, by name.",
                  "type": "string"
                },
                "mcp": {
                  "type": "string"
                },
                "name": {
                  "description": "The variable name, with agent: env.",
                  "type": "string"
                },
                "proxy": {
                  "description": "git | model (later)",
                  "type": "string"
                },
                "sandbox": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "from"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "description": {
      "description": "What this silo is for.",
      "type": "string"
    },
    "git": {
      "description": "Repositories reached through the git proxy (design §9).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "access": {
            "description": "read (default) | push",
            "type": "string"
          },
          "credential": {
            "description": "A credentials[] entry delivered to {proxy: git}.",
            "type": "string"
          },
          "force": {
            "description": "false (default): non-fast-forward pushes are refused.",
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "push": {
            "description": "Ref patterns a push may update: refs/heads/... or refs/tags/..., globbing with * and ?, each optionally followed by (force), (delete) or (force, delete).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "repo": {
            "description": "host/owner/name, such as github.com/acme/widgets.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "repo"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "local": {
      "additionalProperties": false,
      "description": "The local executor: scripts on the invoking machine (design §12).",
      "properties": {
        "output_cap": {
          "description": "Per stream; default 1MiB. A size in bytes, with an optional unit: 1MiB, 4Gi, 10GB.",
          "pattern": "^[0-9]+(B|[KMGT]i?B?)?$",
          "type": [
            "string",
            "integer"
          ]
        },
        "scripts": {
          "additionalProperties": false,
          "properties": {
            "dir": {
              "description": "Every executable directly in it; default scripts.",
              "type": "string"
            },
            "list": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "approve": {
                    "description": "Each call waits for the user's approval.",
                    "type": "boolean"
                  },
                  "description": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "timeout": {
                    "description": "A duration: number-and-unit pairs (w, d, h, m, s), such as 7d or 1h30m; 0 is zero.",
                    "pattern": "^(0|([0-9]+[wdhms])+)$",
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "timeout": {
          "description": "Default 5m. A duration: number-and-unit pairs (w, d, h, m, s), such as 7d or 1h30m; 0 is zero.",
          "pattern": "^(0|([0-9]+[wdhms])+)$",
          "type": [
            "string",
            "integer"
          ]
        },
        "workdir": {
          "description": "A directory in the silo folder; default the folder itself.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "location": {
      "additionalProperties": false,
      "description": "Where the agent CLI runs (design §5). Default: local.",
      "properties": {
        "k8s": {
          "additionalProperties": false,
          "description": "Only for kind: k8s.",
          "properties": {
            "context": {
              "description": "A context in the kubeconfig; kubectl's current context when empty.",
              "type": "string"
            },
            "identity": {
              "additionalProperties": false,
              "description": "Later: workload identity (design §5.4).",
              "properties": {
                "gcp_account_for": {
                  "description": "The projects[] entry whose per-user account the pod's service account is bound to.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "image": {
              "description": "The image the agent CLI runs in; it needs /bin/sh and the CLI on its PATH.",
              "type": "string"
            },
            "namespace": {
              "description": "The namespace the session's pod and Secret go in; the context's namespace when empty.",
              "type": "string"
            },
            "resources": {
              "additionalProperties": false,
              "description": "The agent container's requests and limits.",
              "properties": {
                "cpu": {
                  "description": "A Kubernetes CPU quantity, such as 2 or 500m.",
                  "type": "string"
                },
                "memory": {
                  "description": "A size, such as 4Gi. A size in bytes, with an optional unit: 1MiB, 4Gi, 10GB.",
                  "pattern": "^[0-9]+(B|[KMGT]i?B?)?$",
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              },
              "type": "object"
            },
            "tunnel_image": {
              "description": "The gateway tunnel sidecar's image (design §5.4); silo's published one when empty.",
              "type": "string"
            }
          },
          "required": [
            "image"
          ],
          "type": "object"
        },
        "kind": {
          "description": "local (default) | ssh | k8s | vm (later) | ax (later) | capsule (later)",
          "type": "string"
        },
        "ssh": {
          "additionalProperties": false,
          "description": "Only for kind: ssh.",
          "properties": {
            "gateway_transport": {
              "description": "tcp (default) | unix (later)",
              "type": "string"
            },
            "host": {
              "description": "A Host alias in ~/.ssh/config, or a hostname.",
              "type": "string"
            },
            "identity": {
              "description": "An identity file; may be absolute or ~/...",
              "type": "string"
            },
            "port": {
              "minimum": 0,
              "type": "integer"
            },
            "user": {
              "type": "string"
            }
          },
          "required": [
            "host"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "mcp": {
      "description": "MCP servers routed through the gateway (design §13).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "description": "argv of a server silo starts, over stdio.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "from": {
            "description": "\u003csource\u003e:\u003cname\u003e, source one of claude-user, claude-project, mcp-json, codex, agy.",
            "type": "string"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "For url: servers.",
            "type": "object"
          },
          "inherit_env": {
            "description": "Names passed through from silo's environment, or all.",
            "oneOf": [
              {
                "enum": [
                  "all"
                ],
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "name": {
            "description": "The gateway's prefix for the server's tools.",
            "type": "string"
          },
          "required": {
            "description": "Default true.",
            "type": "boolean"
          },
          "restart": {
            "description": "never (default) | on-failure",
            "type": "string"
          },
          "tools": {
            "description": "Allowlist of the server's tool names; default all.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "url": {
            "description": "An already-running server, over Streamable HTTP.",
            "type": "string"
          },
          "where": {
            "description": "local (the invoking machine, default) | remote (the agent host)",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "description": "[a-z0-9-]; used in session ids, audit and service-account descriptions.",
      "type": "string"
    },
    "projects": {
      "description": "GCP projects the agent acts in (design §11).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "description": "Later (grain.md §2.6): a caller-provided identity instead of roles.",
            "type": "string"
          },
          "allow_basic_roles": {
            "description": "roles/owner, roles/editor and roles/viewer need this.",
            "type": "boolean"
          },
          "attach_to": {
            "description": "Later (stage 10, journey 5).",
            "type": "string"
          },
          "deliver_to": {
            "description": "Sandboxes that get the token.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "project": {
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ttl": {
            "description": "Idle time before silo gc may delete the account; 0 deletes it on exit. A duration: number-and-unit pairs (w, d, h, m, s), such as 7d or 1h30m; 0 is zero.",
            "pattern": "^(0|([0-9]+[wdhms])+)$",
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "required": [
          "project"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "remote_permissions": {
      "description": "What the CLI's own built-in tools may do on the agent host: none (default), all, or a list of the CLI's own tool names (design §6.1).",
      "oneOf": [
        {
          "enum": [
            "none",
            "all"
          ],
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "sandboxes": {
      "description": "Named places where commands run on the agent's behalf (design §7).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "args": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Granule only (stage 8).",
            "type": "object"
          },
          "backend": {
            "description": "local (default) | {k8s: {...}} (later, stage 11b)",
            "oneOf": [
              {
                "enum": [
                  "local"
                ],
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "k8s": {
                    "additionalProperties": false,
                    "properties": {
                      "context": {
                        "type": "string"
                      },
                      "namespace": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "k8s"
                ],
                "type": "object"
              }
            ]
          },
          "build": {
            "description": "A Dockerfile in the silo folder, built into the image.",
            "type": "string"
          },
          "cpus": {
            "minimum": 0,
            "type": "number"
          },
          "disk": {
            "description": "A size, such as 20Gi. A size in bytes, with an optional unit: 1MiB, 4Gi, 10GB.",
            "pattern": "^[0-9]+(B|[KMGT]i?B?)?$",
            "type": [
              "string",
              "integer"
            ]
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "granulefile": {
            "description": "Granule only (stage 8): a Granulefile in the silo folder.",
            "type": "string"
          },
          "image": {
            "description": "An OCI image, or for granule a granule VM image.",
            "type": "string"
          },
          "kind": {
            "description": "container | gvisor | granule (later, stage 8) | folder (built-in silos only)",
            "type": "string"
          },
          "lifetime": {
            "description": "session (default) | persistent (later)",
            "type": "string"
          },
          "memory": {
            "description": "A size, such as 4Gi. A size in bytes, with an optional unit: 1MiB, 4Gi, 10GB.",
            "pattern": "^[0-9]+(B|[KMGT]i?B?)?$",
            "type": [
              "string",
              "integer"
            ]
          },
          "model_access": {
            "description": "Later: the model proxy (grain.md §2.5).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "mounts": {
            "description": "Read-only unless rw: true.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "from": {
                  "description": "A path in the silo folder.",
                  "type": "string"
                },
                "rw": {
                  "type": "boolean"
                },
                "to": {
                  "description": "An absolute path in the sandbox.",
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "network": {
            "description": "none (default) | open | {allow: [host, ...]} (later)",
            "oneOf": [
              {
                "enum": [
                  "none",
                  "open"
                ],
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "allow": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "allow"
                ],
                "type": "object"
              }
            ]
          },
          "package_cache": {
            "additionalProperties": false,
            "description": "Later (grain.md §2.3).",
            "properties": {
              "ca": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "path": {
            "description": "Folder sandboxes only (built-in silos).",
            "type": "string"
          },
          "repos": {
            "description": "git[] entries checked out through the git proxy: one at workdir, several each at workdir/\u003cname\u003e. Needs an absolute workdir and git in the image.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rw": {
            "description": "Folder sandboxes only (built-in silos).",
            "type": "boolean"
          },
          "target": {
            "description": "Granule only (stage 8).",
            "type": "string"
          },
          "workdir": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "silo": {
      "const": "v2",
      "description": "Schema version. Must be the first key, and must be v2."
    }
  },
  "required": [
    "silo",
    "name",
    "agent"
  ],
  "title": "Silofile",
  "type": "object"
}
