{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "annotations": {
      "silo.dev/origin": "debian@host",
      "silo.dev/sandbox": "bare"
    },
    "labels": {
      "app.kubernetes.io/managed-by": "silo",
      "silo.dev/role": "sandbox",
      "silo.dev/session": "s-abcdefghijkl"
    },
    "name": "silo-s-abcdefghijkl-fsuny7rt"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "args": [
          "run"
        ],
        "env": [
          {
            "name": "CHV_NET_MODE",
            "value": "none"
          },
          {
            "name": "CHV_SHUTDOWN_TIMEOUT",
            "value": "20s"
          }
        ],
        "image": "guest:1",
        "name": "vm",
        "readinessProbe": {
          "exec": {
            "command": [
              "/usr/local/bin/granule",
              "ready",
              "-timeout",
              "0"
            ]
          },
          "periodSeconds": 2,
          "timeoutSeconds": 5
        },
        "resources": {
          "limits": {
            "devic.es/kvm": "1"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true
        },
        "volumeMounts": [
          {
            "mountPath": "/run",
            "name": "run"
          },
          {
            "mountPath": "/tmp",
            "name": "tmp"
          },
          {
            "mountPath": "/var/lib/granule/overlay",
            "name": "overlay"
          }
        ]
      }
    ],
    "enableServiceLinks": false,
    "restartPolicy": "Never",
    "securityContext": {
      "runAsGroup": 65534,
      "runAsNonRoot": true,
      "runAsUser": 65534,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "terminationGracePeriodSeconds": 40,
    "volumes": [
      {
        "emptyDir": {
          "medium": "Memory"
        },
        "name": "run"
      },
      {
        "emptyDir": {},
        "name": "tmp"
      },
      {
        "emptyDir": {},
        "name": "overlay"
      }
    ]
  }
}
