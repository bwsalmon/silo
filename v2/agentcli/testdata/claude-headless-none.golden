tty: false
argv:
  "/bin/claude"
  "-p"
  "--output-format"
  "stream-json"
  "--verbose"
  "--input-format"
  "stream-json"
  "--model"
  "test-model"
  "--mcp-config"
  "/STAGE/mcp.json"
  "--strict-mcp-config"
  "--tools"
  ""
  "--allowedTools"
  "mcp__silo"
  "--disable-slash-commands"
  "--setting-sources"
  "user"
  "--append-system-prompt-file"
  "/STAGE/system-prompt.md"
env:
  PATH=/bin
  HOME=/home/u
  ANTHROPIC_API_KEY=sk-test
  CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
  DELIVERED=to-agent
  MCP_TOOL_TIMEOUT=1920000
stdin: "{\"message\":{\"content\":[{\"text\":\"do the thing\",\"type\":\"text\"}],\"role\":\"user\"},\"type\":\"user\"}\n"
--- mcp.json
{
  "mcpServers": {
    "silo": {
      "headers": {
        "Authorization": "Bearer TOKEN"
      },
      "type": "http",
      "url": "http://127.0.0.1:41234/mcp"
    }
  }
}
--- system-prompt.md
be careful
