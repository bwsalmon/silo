# Pinned versions for v3/deploy/install.sh. This is the one place they are
# recorded: bump a version here, re-run install.sh, and it installs exactly
# that. The file is sourced by bash, so keep it to plain KEY=value lines.

# The silo release install.sh downloads with --release (no "v" prefix
# needed). Building from source ignores it.
SILO_VERSION=0.3.0

# Node.js major version, from NodeSource when the distribution's nodejs is
# older. Claude Code and its ACP adapter need Node >= 22.
NODE_MAJOR=22

# The three coding-agent CLIs and their ACP adapters (design §5.1), as npm
# package@version, installed into /opt/silo/cli. Gemini CLI speaks ACP
# itself (--experimental-acp); Claude Code and Codex need an adapter.
CLAUDE_CODE_PKG=@anthropic-ai/claude-code@2.1.310
CLAUDE_ACP_PKG=@agentclientprotocol/claude-agent-acp@0.95.0
CODEX_PKG=@openai/codex@0.164.0
CODEX_ACP_PKG=@agentclientprotocol/codex-acp@2.2.2
GEMINI_CLI_PKG=@google/gemini-cli@0.65.0
